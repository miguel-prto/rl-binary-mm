# Copy to .env and fill in. Never commit .env.

# Kalshi (read-only API key)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi.pem

# Polymarket CLOB API credentials (derived from a throwaway wallet, no funds)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Recorder
TFG_DATA_DIR=./data

# Recording server, used by `python -m tfg.recorder.pull`
TFG_REMOTE_HOST=
TFG_REMOTE_KEY=
TFG_REMOTE_DIR=tfg-data
